{
  "name": "coding-agent",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "bin": { "coding-agent": "dist/main.js" },
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx --watch src/main.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -b",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/tool-unit/*.test.ts",
    "eval": "node --import tsx --test evals/**/*.test.ts",
    "eval:mock": "node --import tsx --test evals/one-turn-tools/*.test.ts evals/multi-turn-tools/*.test.ts",
    "eval:smoke": "RUN_REAL_MODEL_EVALS=1 node --import tsx --test evals/smoke-real-model/*.test.ts",
    "check": "biome check --write",
    "prepare": "pnpm clean && tsc -b tsconfig.build.json --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.1.2",
  "devDependencies": {
    "@biomejs/biome": "2.4.15",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.8.0",
    "@types/react": "^19.2.14",
    "lefthook": "^2.1.6",
    "tsx": "^4.22.1",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.78",
    "@ai-sdk/openai": "^3.0.64",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ai": "^6.0.184",
    "dedent": "^1.7.2",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "globby": "^16.2.0",
    "ink": "^7.0.3",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.0",
    "marked": "^18.0.3",
    "marked-terminal": "^7.3.0",
    "openai": "^6.38.0",
    "react": "^19.2.6",
    "valtio": "^2.3.2",
    "zod": "^4.4.3"
  }
}
