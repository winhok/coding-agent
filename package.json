{
  "name": "coding-agent",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "bin": { "coding-agent": "dist/main.js" },
  "type": "module",
  "files": ["dist"],
  "scripts": {
    "start": "tsx src/index.ts",
    "continue": "tsx src/index.ts --continue",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm clean && tsc -b tsconfig.build.json --force",
    "typecheck": "tsc -b --force",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "test:unit": "node --import tsx --test tests/tool-unit/*.test.ts",
    "eval": "node --import tsx --test evals/**/*.test.ts",
    "eval:mock": "node --import tsx --test evals/one-turn-tools/*.test.ts evals/multi-turn-tools/*.test.ts",
    "eval:smoke": "RUN_REAL_MODEL_EVALS=1 node --import tsx --test evals/smoke-real-model/*.test.ts",
    "check": "biome check --write",
    "prepare": "pnpm clean && tsc -b tsconfig.build.json --force"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@11.20.0",
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/better-sqlite3": "^9.6.0",
    "@types/json-schema": "^7.0.15",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "lefthook": "^2.1.10",
    "tsx": "^4.23.9",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.33",
    "@ai-sdk/openai": "^4.0.33",
    "@inkjs/ui": "^2.0.0",
    "@larksuiteoapi/node-sdk": "^1.72.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.55",
    "better-sqlite3": "^13.0.3",
    "dedent": "^1.7.2",
    "dotenv": "^17.4.2",
    "fast-glob": "^3.3.3",
    "globby": "^16.2.2",
    "ink": "^7.1.1",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^4.0.1",
    "marked": "^18.0.9",
    "marked-terminal": "^7.3.0",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "sqlite-vec": "^0.1.9",
    "valtio": "^2.3.2",
    "zod": "^4.4.3"
  }
}
